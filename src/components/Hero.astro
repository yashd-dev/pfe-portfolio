---
const portraitUrl =
  "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=1400&q=85";
---

<main class="hero" aria-labelledby="hero-title">
  <section class="hero-content">
    <div class="availability">
      <span aria-hidden="true"></span>
      Open for new projects
    </div>

    <div class="hero-copy">
      <h1 id="hero-title">
        Crafted experiences, designed to be beautiful and built to last.
      </h1>
      <p class="intro">
        I’m a freelance web designer and developer building with modern web
        technologies from my studio in India.
      </p>
      <a class="button" href="#work">Find out more</a>
    </div>

    <footer class="socials" aria-label="Social links">
      <p>
        Find me at <a
          href="https://github.com/"
          target="_blank"
          rel="noreferrer">GitHub</a
        > and <a
          href="https://www.linkedin.com/"
          target="_blank"
          rel="noreferrer">LinkedIn</a
        >.
      </p>
      <p>Download my <a href="/resume.pdf">resume</a> (PDF 248kb)</p>
    </footer>
  </section>

  <section class="hero-portrait" aria-label="Portrait of Aditya Sharma">
    <img src={portraitUrl} alt="Portrait of Aditya Sharma" />
  </section>
</main>

<style>
  .hero {
    display: grid;
    grid-template-columns: 50% 50%;
    min-height: 100vh;
    background: var(--color-surface);
  }

  .hero-content {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    justify-content: space-between;
    padding: 3.25rem 4.5rem;
  }

  .availability {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    background: var(--color-background);
    padding: 0.35rem 0.65rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .availability span {
    display: block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-online);
    box-shadow: 0 0 18px rgb(167 251 128 / 0.75);
  }

  .hero-copy {
    max-width: 34rem;
    padding: 3vh 0;
  }

  h1 {
    margin: 0;
    max-width: 33rem;
    font-size: clamp(2.75rem, 3.35vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .intro {
    max-width: 28rem;
    margin: 1.4rem 0 0;
    color: var(--color-text-subtle);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.4;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 9rem;
    margin-top: 2rem;
    border-radius: 999px;
    background: var(--color-button);
    color: var(--color-button-text);
    padding: 0.8rem 1.25rem;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    background: var(--color-taupe-100);
    transform: translateY(-2px);
  }

  .socials {
    color: var(--color-text-subtle);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .socials p {
    margin: 0;
  }

  .socials a {
    color: var(--color-accent);
    text-underline-offset: 0.12em;
  }

  .hero-portrait {
    position: relative;
    align-self: stretch;
    height: 100vh;
    max-height: 100vh;
    overflow: hidden;
    background: var(--color-taupe-500);
  }

  .hero-portrait img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 100%;
    max-height: 100vh;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.9) contrast(1.02);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-content {
      min-height: auto;
      padding: 2rem;
      gap: 4rem;
    }

    .hero-copy {
      padding: 3rem 0 1rem;
    }

    .hero-portrait {
      min-height: 62vh;
      height: 62vh;
      order: -1;
    }

    .hero-portrait img {
      min-height: 62vh;
      max-height: 62vh;
    }
  }

  @media (max-width: 560px) {
    .hero-content {
      padding: 1.25rem;
      gap: 3rem;
    }

    .hero-copy {
      padding-top: 1.5rem;
    }

    h1 {
      font-size: clamp(3rem, 15vw, 4.6rem);
    }

    .button {
      width: 100%;
    }
  }
</style>
