---
import "../styles/hero.css";

const portraitUrl =
  "https://d27o7y1r7mnbwc.cloudfront.net/media/uploads/clients/simon-baker/images/2025-11-21_142817_Lead_headshot_Simon_Baker_24_2.1.jpg";
---

<main class="hero" aria-labelledby="hero-title">
  <section class="hero-content">
    <div class="availability">
      <span aria-hidden="true"></span>
      Open for new projects
    </div>

    <section
      class="hero-mobile-portrait"
      aria-label="Portrait of Aditya Sharma"
    >
      <img src={portraitUrl} alt="Portrait of Aditya Sharma" />
    </section>

    <div class="hero-copy">
      <h1 id="hero-title">
        Crafted experiences, designed to be beautiful and built to last.
      </h1>
      <p class="intro">
        I’m a freelance web designer and developer building with modern web
        technologies from my studio in India.
      </p>
      <a class="button" href="#work">Find out more</a>
    </div>

    <footer class="socials" aria-label="Social links">
      <p>
        Find me at <a
          href="https://github.com/"
          target="_blank"
          rel="noreferrer">GitHub</a
        > and <a
          href="https://www.linkedin.com/"
          target="_blank"
          rel="noreferrer">LinkedIn</a
        >.
      </p>
      <p>Download my <a href="/resume.pdf">resume</a> (PDF 248kb)</p>
    </footer>
  </section>

  <section class="hero-portrait" aria-label="Portrait of Aditya Sharma">
    <img src={portraitUrl} alt="Portrait of Aditya Sharma" />
  </section>
</main>
