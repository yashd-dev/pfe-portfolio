---
import "../styles/projects.css";

const projects = [
  {
    name: "Ai Weiwei",
    description:
      "Single page side-scrolling experience for the new Ai Weiwei exhibition, Button Up! Built using Next.js, Storyblok, TypeScript, Motion and Tailwind.",
    href: "#",
    image:
      "https://images.unsplash.com/photo-1545987796-200677ee1011?auto=format&fit=crop&w=1400&q=85",
    imageAlt: "Ai Weiwei standing in front of an artwork",
  },
  {
    name: "Ai Weiwei",
    description:
      "Single page side-scrolling experience for the new Ai Weiwei exhibition, Button Up! Built using Next.js, Storyblok, TypeScript, Motion and Tailwind.",
    href: "#",
    image:
      "https://images.unsplash.com/photo-1545987796-200677ee1011?auto=format&fit=crop&w=1400&q=85",
    imageAlt: "Ai Weiwei standing in front of an artwork",
  },
];
---

<section class="projects" id="work" aria-labelledby="projects-title">
  <div class="projects-header">
    <h2 id="projects-title">Projects</h2>
    <p>
      I’ve been helping brands realise their online potential from small and
      medium sized enterprises to large corporate entities, as a solo developer
      or as part of a larger team.
    </p>
  </div>

  <div class="project-list">
    {
      projects.map((project) => (
        <article class="project-card">
          <div class="project-copy">
            <p class="project-name">{project.name}</p>
            <div>
              <h3>{project.description}</h3>
              <a
                href={project.href}
                aria-label={`Open ${project.name} project`}
              >
                Open project
              </a>
            </div>
          </div>

          <div class="project-image">
            <img src={project.image} alt={project.imageAlt} />
          </div>
        </article>
      ))
    }
  </div>
</section>
